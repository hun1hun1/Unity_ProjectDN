  m_Name: 
  m_EditorClassIdentifier: 
  runDefinition: {fileID: 11400000, guid: 70df6c5e874760043acc805e683b7d7c, type: 2}
  supportedContent: 
  mainMenu: {fileID: 507570351}
  characterSelection: {fileID: 1043968200}
  startButton: {fileID: 603395523}
  tutorialButton: {fileID: 2069575074}
  optionsButton: {fileID: 1518133411}
  quitButton: {fileID: 549081278}
  continueButton: {fileID: 348503844}
  settingsUI: {fileID: 1231792247}
  tutorialPanel: {fileID: 504728457}
  tutorialTitle: {fileID: 1457535271}
  tutorialBody: {fileID: 125986201}
  pageIndicator: {fileID: 932364188}
  previousButton: {fileID: 2053149627}
  nextButton: {fileID: 855663634}
  closeTutorialButton: {fileID: 828202256}
  tutorialPages:
  - title: "\uAFC8\uACFC \uC545\uBABD"
    body: "\uAFC8\uACFC \uC545\uBABD\uC740 \uAC01\uAC01\uC758 \uB371\uACFC \uC190\uD328\uB97C
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB294
      \uD574\uB2F9 \uB371\uC758 \uCF54\uC2A4\uD2B8\uC640 \uCE74\uB4DC \uC124\uBA85\uC744
      \uD655\uC778\uD558\uC138\uC694."
  - title: "\uCE74\uB4DC \uC0AC\uC6A9\uACFC \uD134"
    body: "\uC0AC\uC6A9\uD560 \uCE74\uB4DC\uB97C \uC120\uD0DD\uD558\uACE0 \uD544\uC694\uD55C
      \uB300\uC0C1\uC744 \uC9C0\uC815\uD569\uB2C8\uB2E4.\n\uACF5\uACA9\uACFC \uBC29\uC5B4\uB97C
      \uC870\uD569\uD558\uACE0, \uD589\uB3D9\uC744 \uB9C8\uCCE4\uB2E4\uBA74 \uD134
      \uC885\uB8CC \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694.\n\uC801\uC758 \uD589\uB3D9
      \uC608\uACE0\uB97C \uD655\uC778\uD558\uBA70 \uB2E4\uC74C \uD134\uC744 \uC900\uBE44\uD558\uC138\uC694."
  - title: "\uD0C4\uC57D\uACFC \uCE74\uB4DC \uD6A8\uACFC"
    body: "\uC77C\uBD80 \uCE74\uB4DC\uB294 \uD0C4\uC57D\uC774 \uD544\uC694\uD558\uAC70\uB098
      \uD0C4\uC57D\uC744 \uC18C\uBAA8\uD569\uB2C8\uB2E4.\n\uD604\uC7AC \uD0C4\uC57D\uACFC
      \uCE74\uB4DC\uC5D0 \uD45C\uC2DC\uB41C \uC870\uAC74\uC744 \uD655\uC778\uD558\uC138\uC694.\n\uC0C1\uD0DC
      \uD6A8\uACFC\uC640 \uC9C0\uC18D \uD6A8\uACFC\uB294 \uCE74\uB4DC \uC124\uBA85\uACFC
      \uD234\uD301\uC5D0\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - title: "\uB371 \uD655\uC778\uACFC \uC9C4\uD589"
    body: "\uC0C1\uB2E8\uC758 \uB371 \uBC84\uD2BC\uC73C\uB85C \uAFC8\uACFC \uC545\uBABD\uC758
      \uC804\uCCB4 \uBCF4\uC720 \uCE74\uB4DC\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.\n\uBF51\uC744
      \uCE74\uB4DC \uB354\uBBF8\uC640 \uBC84\uB9B0 \uCE74\uB4DC \uB354\uBBF8\uB3C4
      \uB20C\uB7EC \uBAA9\uB85D\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC804\uD22C
      \uD6C4 \uBCF4\uC0C1\uC744 \uBC1B\uACE0 \uB9F5\uC5D0\uC11C \uB2E4\uC74C \uD589\uB3D9\uC744
      \uC120\uD0DD\uD558\uC138\uC694."
  quitPanel: {fileID: 1777963888}
  cancelQuitButton: {fileID: 1016447270}
  confirmQuitButton: {fileID: 1869562193}
  statusText: {fileID: 1893988169}
